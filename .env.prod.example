# 서버의 .env 예시. 서버의 ~/pawmento/.env로 만들어 값을 채운다 (.env는 커밋하지 않는다)
# compose.yaml과 compose.prod.yaml이 읽는다. IMAGE_TAG는 배포 워크플로가 넘기므로 여기에 두지 않는다
# 배포 워크플로는 compose 파일과 nginx 설정만 덮어쓰고 .env는 건드리지 않는다

# 서버에서 직접 docker compose를 실행할 때 -f를 생략할 수 있게 한다 (예: 되돌리기)
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# 공용 서버에서 네트워크·볼륨 이름을 팀별로 나눈다
COMPOSE_PROJECT_NAME=pawmento-develop
# 서버 관리자가 팀에 배정한 포트
TEAM_PORT=
# 이미지 주소 ghcr.io/<GITHUB_OWNER>/pawmento-*
GITHUB_OWNER=likelion-backendschool-9th

POSTGRES_DB=pawmento
POSTGRES_USER=pawmento
# 서버에서 새로 정한다. 로컬·CI 값을 쓰지 않는다. 첫 실행 때 DB에 저장되므로 나중에 바꾸지 않는다
# 예: openssl rand -hex 24
POSTGRES_PASSWORD=

# 로그인 토큰 서명 키. 32바이트 이상. 바꾸면 모든 로그인이 풀린다
# 예: openssl rand -hex 32
JWT_SECRET=

# 네이버 클라우드 플랫폼 Maps 키. 비어 있으면 주소 조회만 건너뛴다
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# 구글 OAuth 클라이언트 키 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보). 비어 있으면 구글 로그인만 막힌다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 디벨로퍼스 REST API 키. Client Secret은 콘솔에서 켰을 때만 넣는다. 비어 있으면 카카오 로그인만 막힌다
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# AI 엽서 생성기 (docs/postcard/generate.md, docs/deploy.md)
# fake는 외부 호출 없이 바탕 그림을 만든다. cloudflare로 바꾸면 아래 두 값이 필요하다(없으면 백엔드가 시작하지 않는다)
PAWMENTO_POSTCARD_GENERATOR=fake
# Cloudflare 계정 ID와 Workers AI 권한만 준 API 토큰
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# 선택: 모델 (기본 @cf/black-forest-labs/flux-2-klein-9b, S7에서 flux-2-klein-4b와 비교)
# PAWMENTO_POSTCARD_CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# 선택: 팀 전체 하루 상한 (Cloudflare 무료 한도를 쓰는 동안 기본 5)
# PAWMENTO_POSTCARD_DAILY_LIMIT_TOTAL=3