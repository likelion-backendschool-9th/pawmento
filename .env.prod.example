# 서버의 .env 예시. 서버의 ~/pawmento/.env로 만들어 값을 채운다 (.env는 커밋하지 않는다)
# compose.yaml과 compose.prod.yaml이 읽는다. IMAGE_TAG는 배포 워크플로가 넘기므로 여기에 두지 않는다
# 배포 워크플로는 compose 파일과 nginx 설정만 덮어쓰고 .env는 건드리지 않는다

# 서버에서 직접 docker compose를 실행할 때 -f를 생략할 수 있게 한다 (예: 되돌리기)
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# 공용 서버에서 네트워크·볼륨 이름을 팀별로 나눈다
COMPOSE_PROJECT_NAME=pawmento-develop
# 서버 관리자가 팀에 배정한 포트
TEAM_PORT=
# 이미지 주소 ghcr.io/<GITHUB_OWNER>/pawmento-*
GITHUB_OWNER=likelion-backendschool-9th

POSTGRES_DB=pawmento
POSTGRES_USER=pawmento
# 서버에서 새로 정한다. 로컬·CI 값을 쓰지 않는다
POSTGRES_PASSWORD=
